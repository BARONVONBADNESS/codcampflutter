# Discord OAuth2 credentials
# Get these from https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# The URL of THIS server's callback endpoint
# Must match what you entered in Discord Developer Portal → OAuth2 → Redirects
DISCORD_REDIRECT_URI=https://your-domain.com/auth/discord/callback

# Custom URL scheme for the mobile app (default: codcamp://auth)
APP_DEEP_LINK=codcamp://auth

# Server port
PORT=3000
