<?xml version="1.0" encoding="utf-8"?>
<!--
    Ghost Protocol — Android Network Security Config

    Allows plain HTTP only to local network addresses (192.168.x.x, 10.x.x.x,
    172.16-31.x.x, and localhost). All other traffic uses the default HTTPS-only
    policy. This is safe for an internal app talking to a local tips server.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- localhost (Chrome/emulator dev) -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- LAN ranges for Android APK connecting to the tips server -->
        <domain includeSubdomains="false">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1</domain>
        <domain includeSubdomains="true">10.0.0</domain>
        <domain includeSubdomains="true">10.0.1</domain>
        <domain includeSubdomains="true">172.16</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
